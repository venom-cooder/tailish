# Tailish — environment configuration
#
# Copy to .env.local. Every value is optional: with none of them set, the site
# runs end to end against the mock adapter in lib/mock.

# ---------------------------------------------------------------- backend --
# Empty (or unset) → the typed mock adapter is used.
# Set → every call in lib/api switches to REST against this origin.
# This is the only change needed to go live. See README → "Pointing it at a
# real backend".
NEXT_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------- whatsapp --
# E.164 without the leading "+". Repoints every WhatsApp button, link and QR
# code on the site.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Fallback prefilled message. Individual pages pass their own context-specific
# text via getWhatsAppLink({ text }).
NEXT_PUBLIC_WHATSAPP_DEFAULT_TEXT="Hi Tailish! I'd like help with my pet's care."

# -------------------------------------------------------------------- site --
# Canonical URLs, sitemap entries, Open Graph tags and generated share links.
NEXT_PUBLIC_SITE_URL=https://tailish.in

# ------------------------------------------------------------- development --
# Simulated latency (ms) for the mock adapter in the browser, so loading states
# are exercised during development. Ignored on the server and when a real API
# is configured.
NEXT_PUBLIC_MOCK_LATENCY_MS=320
